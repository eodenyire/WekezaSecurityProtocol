{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Database=salama_security;Username=wekeza_user;Password=your_password_here"
  },
  "JwtSettings": {
    "SecretKey": "your-super-secret-key-minimum-32-characters-long-for-production",
    "Issuer": "https://api.wekeza.com/security",
    "Audience": "https://wekeza.com",
    "ExpiryHours": 6
  },
  "WekezaApiSettings": {
    "CoreApiBaseUrl": "https://api.wekeza.com/core",
    "ComprehensiveApiBaseUrl": "https://api.wekeza.com/comprehensive",
    "Mvp4ApiBaseUrl": "https://api.wekeza.com/mvp4"
  },
  "SalamaProtocolSettings": {
    "BehavioralThreshold": 0.5,
    "ShadowModeLockoutHours": 6,
    "MinimumBalance": 100,
    "MaximumBalance": 500
  },
  "SocAlertSettings": {
    "AlertEndpoint": "https://soc.wekeza.com/api/alerts",
    "AlertApiKey": "your-soc-api-key-here"
  },
  "RateLimitSettings": {
    "AuthenticationAttemptsPerMinute": 5,
    "TransfersPerHour": 10,
    "BalanceQueriesPerMinute": 30
  }
}
